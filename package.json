{
  "name": "synapseai-creator-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "server": "prisma generate --schema prisma/schema.prisma && tsx server/server.ts",
    "seed": "npm run seed:jobs && npm run seed:marketplace",
    "seed:jobs": "prisma generate --schema prisma/schema.prisma && tsx server/seed.ts",
    "seed:marketplace": "prisma generate --schema prisma/schema.prisma && tsx server/seedMarketplace.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate --schema prisma/schema.postgres.prisma && npx tsc && vite build",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.453.0",
    "nodemailer": "^10.0.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.1",
    "recharts": "^2.12.7",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^10.0.5",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^5.4.8"
  }
}
